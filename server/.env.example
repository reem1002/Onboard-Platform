NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/lms
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Generate each with:  openssl rand -hex 32   (must be different, min 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
# Max lifetime of a "Remember me" sign-in (without it, the session ends with the browser / after 12 h)
REFRESH_TOKEN_TTL_DAYS=30

UPLOAD_DIR=./uploads
# Hard ceiling per uploaded file. Day-to-day limits (per file / per submission / per company storage)
# are set by the platform admin under Settings and can never exceed this.
MAX_UPLOAD_MB=50

# AI grading (drafts only – instructors approve). Choose the engine in the app: Settings → AI grading.
# In-house (free): install Ollama (https://ollama.com/download), then:  ollama pull qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
# Optional hosted engine (paid):
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_GRADING_ENABLED=true

# Branding on generated reports
ORG_NAME=InfoSec4TC
REPORT_ACCENT=B31F2E

# Public address of the web app (used in password-reset links)
APP_URL=http://localhost:5173

# Email (password-reset links). Leave SMTP_HOST empty in development:
# links are then printed in the server console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Onboard <no-reply@example.com>"

# OCR for screenshots, images in Word files and scanned PDFs (free, offline). eng, ara or eng+ara.
OCR_ENABLED=true
OCR_LANGS=eng+ara
OCR_MAX_PAGES=15
